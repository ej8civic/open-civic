{
  "name": "open-civic",
  "private": true,
  "description": "Open-source archive, wiki and simulator for 1990-2002 Honda Civics.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*"],
  "scripts": {
    "validate": "node tools/validate.mjs",
    "gen": "node tools/gen-tables.mjs",
    "check": "node tools/gen-tables.mjs --check && node tools/validate.mjs",
    "site:dev": "npm run dev -w @open-civic/site",
    "site:build": "npm run gen && npm run build -w @open-civic/site"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  }
}
