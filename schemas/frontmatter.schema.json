{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ej8civic.github.io/open-civic/schemas/frontmatter.schema.json",
  "title": "Open Civic doc page frontmatter",
  "type": "object",
  "required": ["title", "description", "applies_to", "markets", "sources", "verified", "updated"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 200 },
    "applies_to": {
      "description": "Chassis / VIN line codes this page is valid for. 'all' = every in-scope Civic.",
      "type": "array", "minItems": 1,
      "items": { "enum": ["all", "EJ1", "EJ6", "EJ7", "EJ8", "EM1", "EK", "EK9", "ES"] }
    },
    "engines": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][0-9]{2}[A-Z][0-9A-Z]*$" } },
    "markets": { "type": "array", "minItems": 1, "items": { "enum": ["BR", "JP", "US"] } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "time_min": { "type": "integer", "minimum": 1 },
    "safety": { "enum": ["low", "medium", "high"] },
    "tools": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "pages": { "type": "string" } }
      }
    },
    "verified": { "description": "true only after a human checked it on a real car.", "type": "boolean" },
    "author": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sidebar": { "type": "object" }
  }
}
